# Copy this file to ".env" and fill it in. Never share or upload the .env file.

# --- Instagram (official Graph API) ---
# Numeric Instagram account ID of your professional (Creator/Business) account.
IG_USER_ID=
# Long-lived access token with permission to publish content.
IG_ACCESS_TOKEN=
# Use https://graph.facebook.com if your token came from Facebook Login,
# or https://graph.instagram.com if it came from Instagram Login.
IG_GRAPH_HOST=https://graph.facebook.com
# Check the current version in Meta's developer docs before first run.
IG_API_VERSION=v21.0

# --- Google Flow ---
FLOW_URL=https://labs.google/fx/tools/flow
# How long to wait for one clip to finish generating.
FLOW_TIMEOUT_SECONDS=600

# --- Safety switch ---
# true  = make the video but do NOT post it (use this until everything is checked)
# false = post to Instagram automatically
DRY_RUN=true
